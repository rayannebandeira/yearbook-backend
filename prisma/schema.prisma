// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Datasource — conexão com o banco PostgreSQL no Neon
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum — valores fixos para o campo role
enum Role {
  USER    // aluno comum
  ADMIN   // administrador (professor ou aluno com permissão especial)
}

// Model Aluno — representa a tabela "Aluno" no banco
model Aluno {
  id            Int        @id @default(autoincrement())
  nome          String
  email         String     @unique
  senhaHash     String
  cidade        String?
  frase         String?
  planosFuturos String?
  fotoUrl       String?
  role          Role       @default(USER)
  criadoEm      DateTime   @default(now())
  mensagens     Mensagem[]
}

model Mensagem {
  id        Int      @id @default(autoincrement())
  texto     String
  imagemUrl String?
  autorId   Int
  autor     Aluno    @relation(fields: [autorId], references: [id])
  criadoEm  DateTime @default(now())
}